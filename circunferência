class Circunferencia extends FormaGeometrica {

    double raio;

    public Circunferencia(double raio) {
        this.raio = raio;
    }

    @Override
    public double getArea() {
        return Math.PI * raio * raio;
    }

    @Override
    public double getPerimetro() {
        return 2 * Math.PI * raio;
    }

    // Método extra
    public double getDiametro() {
        return raio * 2;
    }
}
